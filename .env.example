# バイナリと同じ場所に .env として置くか、環境変数で与える(環境変数が勝つ)。

# このプロセスが動かす連携。1 プロセス 1 連携。
AGENT_ADAPTER=orca-push

# カルテの受信エンドポイントと、管理 > 外部システム連携 で発行した受信トークン。
KARTE_EVENTS_URL=https://example.invalid/integrations/receipt/events
KARTE_INBOUND_TOKEN=

# 送れなかったイベントの退避先。未指定ならバイナリの隣の spool/。
# SPOOL_DIR=/var/lib/fhir-client-agent/spool

# 稼働状況の確認口(/healthz)。未指定なら待ち受けない。
# HEALTH_ADDR=127.0.0.1:8787

LOG_LEVEL=INFO

# --- orca-push: 日レセ(WebORCA)の PUSH 通知 ---
#   オンプレ Ubuntu 22.04 以降 … ws://<日レセ>:8000/ws
#   オンプレ Ubuntu 20.04      … ws://<日レセ>:9400/ws(jma-receipt-pusher が別途要る)
#   クラウド                   … wss://weborca.cloud.orcamo.jp/ws
ORCA_WS_URL=ws://localhost:8000/ws
# オンプレは 1 固定。クラウドは証明書でテナントが決まり、この値は無視される。
ORCA_TENANT_ID=1
# クラウド版のみ。SSL クライアント認証。
# ORCA_TLS_CERT=/etc/fhir-client-agent/client.crt
# ORCA_TLS_KEY=/etc/fhir-client-agent/client.key
# ORCA_TLS_CA=/etc/fhir-client-agent/ca.crt
